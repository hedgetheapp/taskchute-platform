<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/home_widget_surface_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="0dp"
        android:paddingEnd="8dp"
        android:paddingBottom="0dp">

        <TextView
            android:id="@+id/home_widget_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_widget_accent"
            android:textSize="10sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_widget_running_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/home_widget_running_card"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/home_widget_running_surface"
                android:padding="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingEnd="52dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/home_widget_running_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="@string/home_widget_running_label"
                            android:textColor="@color/home_widget_accent"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/home_widget_running_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/home_widget_primary_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/home_widget_running_time_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/home_widget_elapsed_icon"
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_material_schedule_24"
                                android:tint="@color/home_widget_primary_text" />

                            <Chronometer
                                android:id="@+id/home_widget_elapsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:format="%s"
                                android:singleLine="true"
                                android:textColor="@color/home_widget_primary_text"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/home_widget_remaining_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/home_widget_remaining_icon"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_material_hourglass_top_24"
                                android:tint="@color/home_widget_secondary_text" />

                            <Chronometer
                                android:id="@+id/home_widget_remaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:countDown="true"
                                android:format="%s"
                                android:singleLine="true"
                                android:textColor="@color/home_widget_secondary_text"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/home_widget_overrun_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/home_widget_overrun_remaining_icon"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_material_hourglass_top_24"
                                android:tint="@color/home_widget_secondary_text" />

                            <TextView
                                android:id="@+id/home_widget_overrun_zero"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:singleLine="true"
                                android:text="00:00:00"
                                android:textColor="@color/home_widget_secondary_text"
                                android:textSize="8sp" />

                            <ImageView
                                android:id="@+id/home_widget_overrun_icon"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginStart="2dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_material_more_time_24"
                                android:tint="@color/home_widget_overrun" />

                            <Chronometer
                                android:id="@+id/home_widget_overrun"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:format="+%s"
                                android:singleLine="true"
                                android:textColor="@color/home_widget_overrun"
                                android:textSize="8sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="3dp">

                        <ProgressBar
                            android:id="@+id/home_widget_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="1000"
                            android:progress="0"
                            android:progressDrawable="@drawable/home_widget_progress" />

                        <ProgressBar
                            android:id="@+id/home_widget_progress_overrun"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="1000"
                            android:progress="0"
                            android:progressDrawable="@drawable/home_widget_progress_overrun"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/home_widget_complete_action"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/home_widget_running_action_surface"
                    android:contentDescription="@string/home_widget_complete_action"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/home_widget_stop_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_material_stop_24"
                        android:tint="@color/home_widget_accent" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/home_widget_running_next_row"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/home_widget_task_surface"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/home_widget_running_next_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="@string/home_widget_next_label"
                        android:textColor="@color/home_widget_secondary_text"
                        android:textSize="9sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/home_widget_running_next_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/home_widget_primary_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/home_widget_running_next_metadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/home_widget_secondary_text"
                    android:textSize="9sp" />

                <FrameLayout
                    android:id="@+id/home_widget_running_start_preview"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/home_widget_start_blocked_action"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_widget_running_no_next"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/home_widget_task_surface"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="@string/home_widget_no_next_task"
                android:textColor="@color/home_widget_secondary_text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_widget_idle_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/home_widget_idle_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_widget_next_label"
                android:textColor="@color/home_widget_secondary_text"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/home_widget_idle_task_row"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/home_widget_task_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_widget_idle_task_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/home_widget_primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_widget_idle_task_metadata"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/home_widget_secondary_text"
                        android:textSize="9sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/home_widget_idle_start_action"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/home_widget_action_surface"
                    android:contentDescription="@string/home_widget_start_action"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/home_widget_idle_start_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_material_play_arrow_24"
                        android:tint="@color/home_widget_action_icon_tint" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_widget_idle_following_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:background="@drawable/home_widget_task_surface"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/home_widget_idle_following_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/home_widget_primary_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_widget_idle_following_metadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/home_widget_secondary_text"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_widget_idle_empty"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/home_widget_task_surface"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="@string/home_widget_no_next_task"
                android:textColor="@color/home_widget_secondary_text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:textColor="@color/home_widget_secondary_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
