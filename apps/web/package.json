{
  "name": "@taskchute/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:all": "npm run test && npm run test:web",
    "migrate:app:local": "wrangler d1 migrations apply taskchute-app-local --local --persist-to .wrangler/state",
    "migrate:auth:local": "wrangler d1 migrations apply taskchute-auth-local --local --persist-to .wrangler/state",
    "bootstrap:local": "node ./scripts/bootstrap-local.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "better-auth": "1.7.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-plugin": "1.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
