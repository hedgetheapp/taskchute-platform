{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskchute-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  "vars": {
    "RUNTIME_ENV": "local",
    "BOOTSTRAP_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "taskchute-auth-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations/auth"
    },
    {
      "binding": "APP_DB",
      "database_name": "taskchute-app-local",
      "database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "migrations/app"
    }
  ],
  "env": {
    "nonprod": {
      "vars": {
        "RUNTIME_ENV": "nonprod",
        "BOOTSTRAP_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "taskchute-auth-nonprod",
          "database_id": "60085f8d-0c4e-4c15-98e9-3ce178398041",
          "migrations_dir": "migrations/auth"
        },
        {
          "binding": "APP_DB",
          "database_name": "taskchute-app-nonprod",
          "database_id": "6ad7e35f-5d03-4be3-9b00-46cd713a51c3",
          "migrations_dir": "migrations/app"
        }
      ]
    },
    "production": {
      "name": "taskchute-web-production",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "RUNTIME_ENV": "production",
        "BOOTSTRAP_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "taskchute-auth-production",
          "database_id": "c69df774-69c0-43a5-b346-b202ef4a92c3",
          "migrations_dir": "migrations/auth"
        },
        {
          "binding": "APP_DB",
          "database_name": "taskchute-app-production",
          "database_id": "61f07b2b-8bdd-4f5d-853e-6af59afd343c",
          "migrations_dir": "migrations/app"
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
